# ════════════════════════════════════════════════════
# Деловой переводчик-бот — переменные окружения
# Скопируй этот файл: cp env.example tr.env
# Затем заполни значения в tr.env
# ════════════════════════════════════════════════════

# ОБЯЗАТЕЛЬНЫЕ
BOT_TOKEN=           # токен от @BotFather
OWNER_ID=            # ваш Telegram ID (от @userinfobot)

# ОПЕРАТОР 152-ФЗ (отображается в согласии при первом запуске)
OPERATOR_NAME=ИП Фамилия Имя Отчество
OPERATOR_INN=000000000000
OFFER_URL=           # ссылка на оферту (необязательно)
SUPPORT_CONTACT=@username
BOT_OWNER_TITLE=Фамилии Имени

# БЫСТРАЯ РАСШИФРОВКА через OpenAI Whisper (необязательно)
# Без ключа работает локальный faster-whisper — бесплатно, медленнее
OPENAI_API_KEY=
TR_TRIAL_UNTIL=2026-12-31T23:59:59+03:00

# WHITE-LABEL: отдельный файл состояния для каждого клиентского бота
# TR_STATE_FILE=/home/user/projects/my-client/state.json
